# Required. Origin of your self-hosted Headscale server. No cloud default.
# A trailing /api/v1 is stripped. tailscale.com and tailscale.io hosts are refused.
HEADSCALE_URL=http://127.0.0.1:8080

# API key from `headscale apikeys create`. Sent as Authorization: Bearer. Never printed.
HEADSCALE_API_KEY=

# Must be the literal true before a confirmed write is sent.
HEADSCALE_ALLOW_WRITES=false

# Comma list, or all. Default is nodes,users,policy,meta. debug is only in all.
HEADSCALE_TOOLSETS=nodes,users,policy,meta

# Local sliding window. Cache hits do not spend it.
HEADSCALE_PER_MINUTE=30

# GET cache TTL in seconds. 0 disables caching. Writes clear the cache.
HEADSCALE_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
HEADSCALE_TIMEOUT_MS=20000

# Contact embedded in the User-Agent. Must not be the API key.
HEADSCALE_CONTACT=you@example.com

# stdio (default) or http. --http on the command line forces http.
MCP_TRANSPORT=stdio
PORT=3000
